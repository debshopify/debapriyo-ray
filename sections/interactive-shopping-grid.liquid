
{% liquid
  assign section_heading = section.settings.heading
%}

<section
  id="InteractiveShopping-{{ section.id }}"
  class="interactive-shopping"
  data-section-id="{{ section.id }}"
>
  {% if section_heading != blank %}
    <h2 class="interactive-shopping__heading">
      {{ section_heading | escape }}
    </h2>
  {% endif %}

  <div class="interactive-shopping__grid">
    {% for block in section.blocks %}
      
        {% assign product = block.settings.product %}

        {% if product != blank %}

        <script
            type="application/json"
            id="ProductData-{{ section.id }}-{{ block.id }}"
            data-product-data
        >
            {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "handle": {{ product.handle | json }},
            "description": {{ product.description | json }},
            "featured_image": {{ product.featured_image | image_url: width: 800 | json }},
            "options": {{ product.options | json }},
            "variants": [
                {% for variant in product.variants %}
                {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "compare_at_price": {{ variant.compare_at_price | json }},
                    "options": {{ variant.options | json }},
                    "featured_image": {{ variant.featured_image | image_url: width: 800 | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endfor %}
            ]
            }
        </script>

        {% endif %}

    {% endfor %}
  </div>

  <!-- Product popup -->
  <div
    class="interactive-shopping__overlay"
    id="ShoppingPopup-{{ section.id }}"
    aria-hidden="true"
  >
    <div class="interactive-shopping__backdrop" data-popup-close></div>

    <div
      class="interactive-shopping__modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ShoppingProductTitle-{{ section.id }}"
    >
      <button
        type="button"
        class="interactive-shopping__close"
        aria-label="Close popup"
        data-popup-close
      >
        &times;
      </button>

      <div class="interactive-shopping__product">
        <div class="interactive-shopping__product-image-wrapper">
          <img
            class="interactive-shopping__product-image"
            src=""
            alt=""
            width="400"
            height="400"
          >
        </div>

        <div class="interactive-shopping__product-info">
          <h3
            class="interactive-shopping__product-title"
            id="ShoppingProductTitle-{{ section.id }}"
          ></h3>

          <p class="interactive-shopping__product-price"></p>

          <div class="interactive-shopping__product-description"></div>
        </div>
      </div>

      <form class="interactive-shopping__form">
        <div class="interactive-shopping__options"></div>

        <button
          type="submit"
          class="interactive-shopping__add-button"
        >
          <span>ADD TO CART</span>
          <span class="interactive-shopping__arrow">&rarr;</span>
        </button>

        <p
          class="interactive-shopping__message"
          role="status"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>
</section>

<style>
  #InteractiveShopping-{{ section.id }} {
    width: 100%;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__heading {
    text-align: center;
    margin: 0 0 30px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__item {
    position: relative;
    overflow: hidden;
    background: #f2f2f2;
    aspect-ratio: 1 / 1;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__image,
  #InteractiveShopping-{{ section.id }} .interactive-shopping__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 27px;
    height: 27px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 5px rgba(0, 0, 0, .2);
    transition: transform .2s ease, background .2s ease;
    z-index: 2;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.2);
    background: #fff;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay.is-open {
    display: flex;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .48);
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__modal {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 390px;
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    padding: 45px 25px 25px;
    box-sizing: border-box;
    color: #111;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__close {
    position: absolute;
    top: 10px;
    right: 15px;
    border: 0;
    background: transparent;
    font-size: 29px;
    line-height: 1;
    cursor: pointer;
    color: #111;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product {
    display: grid;
    grid-template-columns: 44% 1fr;
    gap: 12px;
    align-items: start;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-title {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.35;
    margin: 3px 0 12px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-price {
    font-size: 21px;
    margin: 0 0 12px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-description {
    font-size: 15px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__form {
    margin-top: 15px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option {
    margin-bottom: 16px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option label {
    display: block;
    font-size: 16px;
    margin-bottom: 8px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option select {
    width: 100%;
    height: 51px;
    padding: 0 14px;
    background: #fff;
    border: 1px solid #aaa;
    border-radius: 0;
    color: #111;
    font-size: 16px;
    cursor: pointer;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__add-button {
    width: 100%;
    height: 57px;
    margin-top: 45px;
    padding: 0 22px;
    border: none;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 16px;
    letter-spacing: .4px;
    cursor: pointer;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__add-button:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__arrow {
    font-size: 26px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__message {
    font-size: 13px;
    margin: 10px 0 0;
  }

  @media (max-width: 749px) {
    #InteractiveShopping-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay {
      padding: 12px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__modal {
      max-width: 420px;
      padding: 42px 18px 20px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product {
      grid-template-columns: 42% 1fr;
      gap: 10px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-title {
      font-size: 17px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-price {
      font-size: 18px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-description {
      font-size: 13px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__add-button {
      margin-top: 25px;
    }
  }
</style>


(function () {
  // Register global listeners only once.
  if (window.interactiveShoppingInitialized) return;
  window.interactiveShoppingInitialized = true;

  let activeRoot = null;
  let activeVariant = null;
  let previousFocus = null;

  function formatPrice(cents, currency) {
    return new Intl.NumberFormat(
      document.documentElement.lang || 'en',
      {
        style: 'currency',
        currency: currency
      }
    ).format(cents / 100);
  }

  function openPopup(root, product, trigger) {
    const popup = root.querySelector('.interactive-shopping__overlay');

    if (!popup || !product || !product.variants) return;

    activeRoot = root;
    previousFocus = trigger;

    const image = popup.querySelector('.interactive-shopping__product-image');
    const title = popup.querySelector('.interactive-shopping__product-title');
    const price = popup.querySelector('.interactive-shopping__product-price');
    const description = popup.querySelector('.interactive-shopping__product-description');
    const options = popup.querySelector('.interactive-shopping__options');
    const message = popup.querySelector('.interactive-shopping__message');
    const button = popup.querySelector('.interactive-shopping__add-button');

    const currency = root.dataset.currency || 'INR';

    title.textContent = product.title || '';

    image.src = product.featured_image || '';
    image.alt = product.title || '';

    description.textContent = product.description
      ? product.description.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim()
      : '';

    options.replaceChildren();
    message.textContent = '';

    // Select first available variant.
    activeVariant = product.variants.find(v => v.available)
      || product.variants[0];

    if (!activeVariant) return;

    // Generate product option dropdowns.
    product.options.forEach((optionName, index) => {
      const values = [
        ...new Set(
          product.variants.map(variant => variant.options[index])
        )
      ];

      // Hide Shopify's default variant option.
      if (
        optionName === 'Title' &&
        values.length === 1 &&
        values[0] === 'Default Title'
      ) {
        return;
      }

      const wrapper = document.createElement('div');
      wrapper.className = 'interactive-shopping__option';

      const label = document.createElement('label');
      label.textContent = optionName;

      const select = document.createElement('select');

      values.forEach(value => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });

      select.value = activeVariant.options[index];

      select.dataset.optionIndex = index;

      wrapper.append(label, select);
      options.appendChild(wrapper);
    });

    function updateSelectedVariant() {
      const selectedOptions = Array.from(
        options.querySelectorAll('select')
      ).sort((a, b) => {
        return Number(a.dataset.optionIndex) -
          Number(b.dataset.optionIndex);
      });

      const values = product.options.map((option, index) => {
        const select = Array.from(
          options.querySelectorAll('select')
        ).find(el => Number(el.dataset.optionIndex) === index);

        return select ? select.value : activeVariant.options[index];
      });

      const matchingVariant = product.variants.find(variant =>
        variant.options.every((value, index) => value === values[index])
      );

      if (!matchingVariant) {
        activeVariant = null;
        price.textContent = 'Variant unavailable';
        button.disabled = true;
        return;
      }

      activeVariant = matchingVariant;

      price.textContent = formatPrice(
        activeVariant.price,
        currency
      );

      if (
        activeVariant.compare_at_price &&
        activeVariant.compare_at_price > activeVariant.price
      ) {
        const oldPrice = document.createElement('del');
        oldPrice.textContent = formatPrice(
          activeVariant.compare_at_price,
          currency
        );
        price.appendChild(oldPrice);
      }

      button.disabled = !activeVariant.available;

      button.querySelector('span:first-child').textContent =
        activeVariant.available ? 'ADD TO CART' : 'SOLD OUT';
    }

    options.querySelectorAll('select').forEach(select => {
      select.addEventListener('change', updateSelectedVariant);
    });

    updateSelectedVariant();

    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';

    popup.querySelector('.interactive-shopping__close').focus();
  }

  function closePopup() {
    if (!activeRoot) return;

    const popup = activeRoot.querySelector(
      '.interactive-shopping__overlay'
    );

    popup.classList.remove('is-open');
    popup.setAttribute('aria-hidden', 'true');

    document.body.style.overflow = '';

    if (previousFocus && previousFocus.isConnected) {
      previousFocus.focus();
    }

    activeRoot = null;
    activeVariant = null;
  }

  // Handle hotspot clicks, including dynamically loaded sections.
  document.addEventListener('click', function (event) {
    const trigger = event.target.closest('[data-product-trigger]');

    if (trigger) {
      const root = trigger.closest('.interactive-shopping');

      if (!root) return;

      const productScript = root.querySelector(
        '#' + CSS.escape(trigger.dataset.productJson)
      );

      if (!productScript) {
        console.error('Product JSON not found.');
        return;
      }

      try {
        const product = JSON.parse(productScript.textContent);
        openPopup(root, product, trigger);
      } catch (error) {
        console.error('Product JSON parsing failed:', error);
      }

      return;
    }

    if (
      activeRoot &&
      event.target.closest('[data-popup-close]') &&
      activeRoot.contains(event.target)
    ) {
      closePopup();
    }
  });

  // Close popup using Escape.
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && activeRoot) {
      closePopup();
    }
  });

  // AJAX Add to Cart.
  document.addEventListener('submit', async function (event) {
    const form = event.target.closest('.interactive-shopping__form');

    if (!form || !activeRoot || !activeVariant) return;

    event.preventDefault();

    const button = form.querySelector('.interactive-shopping__add-button');
    const message = form.querySelector('.interactive-shopping__message');

    if (!activeVariant.available) return;

    button.disabled = true;
    message.textContent = 'Adding to cart...';

    try {
      const response = await fetch(
        (window.Shopify?.routes?.root || '/') + 'cart/add.js',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: activeVariant.id,
            quantity: 1
          })
        }
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          result.description || result.message || 'Unable to add product.'
        );
      }

      message.textContent = 'Product added successfully!';

      document.dispatchEvent(
        new CustomEvent('cart:refresh', { bubbles: true })
      );

    } catch (error) {
      message.textContent = error.message;

    } finally {
      button.disabled = !activeVariant || !activeVariant.available;
    }
  });

})();


{% schema %}
{
  "name": "Interactive shopping grid",
  "tag": "section",
  "class": "section-interactive-shopping",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Image spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum grid width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "shopping_item",
      "name": "Shopping image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Shopify product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Interactive shopping grid",
      "blocks": [
        { "type": "shopping_item" },
        { "type": "shopping_item" },
        { "type": "shopping_item" },
        { "type": "shopping_item" },
        { "type": "shopping_item" },
        { "type": "shopping_item" }
      ]
    }
  ]
}
{% endschema %}
