
{% liquid
  assign section_heading = section.settings.heading
%}

<section
  id="InteractiveShopping-{{ section.id }}"
  class="interactive-shopping"
  data-section-id="{{ section.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  {% if section_heading != blank %}
    <h2 class="interactive-shopping__heading">
      {{ section_heading | escape }}
    </h2>
  {% endif %}

  <div class="interactive-shopping__grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% assign hotspot_image = block.settings.image %}

      <div class="interactive-shopping__item" {{ block.shopify_attributes }}>
        {% if hotspot_image != blank %}
          {{
            hotspot_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'interactive-shopping__image',
              alt: hotspot_image.alt
          }}
        {% elsif product != blank and product.featured_image != blank %}
          {{
            product.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'interactive-shopping__image',
              alt: product.title
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'interactive-shopping__placeholder' }}
        {% endif %}

        {% if product != blank %}
          <button
            type="button"
            class="interactive-shopping__hotspot"
            style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
            aria-label="View {{ product.title | escape }}"
            aria-haspopup="dialog"
            aria-controls="ShoppingPopup-{{ section.id }}"
            data-product-trigger
            data-product-json="ProductData-{{ section.id }}-{{ block.id }}"
          >
            <span>+</span>
          </button>

          <script
            type="application/json"
            id="ProductData-{{ section.id }}-{{ block.id }}"
            data-product-data
          >
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "description": {{ product.description | json }},
              "featured_image": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
              "options": {{ product.options | json }},
              "variants": [
                {% for variant in product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "compare_at_price": {{ variant.compare_at_price | json }},
                    "options": {{ variant.options | json }},
                    "featured_image": {% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- PRODUCT POPUP -->
  <div
    class="interactive-shopping__overlay"
    id="ShoppingPopup-{{ section.id }}"
    aria-hidden="true"
  >
    <div class="interactive-shopping__backdrop" data-popup-close></div>

    <div
      class="interactive-shopping__modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ShoppingProductTitle-{{ section.id }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="interactive-shopping__close"
        data-popup-close
        aria-label="Close popup"
      >
        &times;
      </button>

      <div class="interactive-shopping__product">
        <div class="interactive-shopping__product-image-wrapper">
          <img
            class="interactive-shopping__product-image"
            src=""
            alt=""
            width="400"
            height="400"
          >
        </div>

        <div class="interactive-shopping__product-info">
          <h3
            class="interactive-shopping__product-title"
            id="ShoppingProductTitle-{{ section.id }}"
          ></h3>

          <p class="interactive-shopping__product-price"></p>

          <div class="interactive-shopping__product-description"></div>
        </div>
      </div>

      <form class="interactive-shopping__form">
        <div class="interactive-shopping__options"></div>

        <button type="submit" class="interactive-shopping__add-button">
          <span>ADD TO CART</span>
          <span class="interactive-shopping__arrow">&rarr;</span>
        </button>

        <p
          class="interactive-shopping__message"
          role="status"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>
</section>

<style>
  #InteractiveShopping-{{ section.id }} {
    width: 100%;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  #InteractiveShopping-{{ section.id }} * {
    box-sizing: border-box;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__heading {
    text-align: center;
    margin: 0 0 30px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__item {
    position: relative;
    overflow: hidden;
    background: #f2f2f2;
    aspect-ratio: 1 / 1;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__image,
  #InteractiveShopping-{{ section.id }} .interactive-shopping__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* HOTSPOT */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #111;
    font-size: 21px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 6px rgba(0, 0, 0, .2);
    transition: transform .2s ease;
    z-index: 5;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.2);
  }

  /* POPUP */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay.is-open {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .5);
    cursor: pointer;
  }

  .interactive-shopping__options {
    max-width: 271px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__modal {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 311px;
    overflow-y: auto;
    background: #fff;
    padding: 20px 20px;
    color: #111;
    box-shadow: 0 10px 40px rgba(0, 0, 0, .15);
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__close {
    border: 0;
    background: transparent;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    color: #111;
    padding: 5px;
  }

  /* PRODUCT DETAILS */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__product {
    display: flex;
    gap: 8px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product > :last-child {
    flex: 0 0 55%;
  }

  .interactive-shopping__option label {
    font-size: 14px !important;
    font-weight: 400 !important;
  }

  .interactive-shopping__option label {
    font-size: 14px !important;
    font-weight: 400 !important;
  }

  .interactive-shopping__swatch-name {
    font-weight: 400 !important;
    font-style: Regular !important;
    font-size: 18px !important;
    line-height: 100% !important;
    letter-spacing: -2% !important;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-title {
    font-size: 16px;
    font-weight: 300;
    line-height: 120%;
    margin: 3px 0 12px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-price {
    font-size: 21px;
    margin: 0 0 12px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-price del {
    margin-left: 7px;
    font-size: 15px;
    color: #888;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__product-description {
    font-size: 12px;
    font-weight: 300;
    line-height: 110%;
    letter-spacing: -1%;
    overflow-wrap: anywhere;
  }

  /* VARIANT OPTIONS */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__form {
    margin-top: 20px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option {
    margin-bottom: 16px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option label {
    display: block;
    font-size: 15px;
    margin-bottom: 10px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__option select:not([hidden]) {
    width: 100%;
    height: 39.63px;
    padding: 0 14px;
    background: #fff;
    border: 1px solid #aaa;
    border-radius: 0;
    color: #111;
    font-size: 15px;
    cursor: pointer;
  }

  /* COLOR SWATCHES */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__swatches {
  display: flex;
  align-items: center;
  gap: 0px;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-width: 50%;
  min-height: 39.63px;
  border: 1px solid #ddd;
  background: #fff;
  color: #111;
  cursor: pointer;
  transition: border-color .2s ease;
  padding: 0px;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch:hover {
  border-color: #777;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch.is-selected {
  border: 2px solid #111;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch-color {
  display: block;
  width: 4.84px;
  height: 39.63px;
  border-right: 1px solid rgba(0, 0, 0, .15);
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch.is-selected {
  background: #000;
  border: 2px solid #000;
  color: #fff;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch.is-selected .interactive-shopping__swatch-name {
  color: #fff;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch-name {
  font-size: 13px;
  line-height: 1.3;
  text-transform: capitalize;
}

#InteractiveShopping-{{ section.id }} .interactive-shopping__swatch:focus-visible {
  outline: 2px solid #111;
  outline-offset: 3px;
}

  /* ADD TO CART */
  #InteractiveShopping-{{ section.id }} .interactive-shopping__add-button {
    width: 100%;
    min-height: 40px;
    margin-top: 25px;
    padding: 10px 20px;
    border: none;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    letter-spacing: .4px;
    cursor: pointer;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__add-button:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__arrow {
    font-size: 26px;
  }

  #InteractiveShopping-{{ section.id }} .interactive-shopping__message {
    font-size: 13px;
    margin: 10px 0 0;
  }

  @media (max-width: 749px) {
    #InteractiveShopping-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__overlay {
      padding: 12px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__modal {
      max-width: 344px;
      padding: 16px 8px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product {
      grid-template-columns: 42% 1fr;
      gap: 8px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-title {
      font-size: 17px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-price {
      font-size: 18px;
    }

    #InteractiveShopping-{{ section.id }} .interactive-shopping__product-description {
      font-size: 13px;
    }
  }
</style>

<script>
(function () {
  /*
   * Global guard prevents duplicate document-level event listeners.
   */
  if (window.interactiveShoppingInitialized) return;
  window.interactiveShoppingInitialized = true;

  let activeRoot = null;
  let activeProduct = null;
  let activeVariant = null;
  let previousFocus = null;

  function getElements(root) {
    const popup = root.querySelector('.interactive-shopping__overlay');

    if (!popup) {
      console.error('Shopping popup element not found.');
      return null;
    }

    return {
      popup: popup,
      image: popup.querySelector('.interactive-shopping__product-image'),
      title: popup.querySelector('.interactive-shopping__product-title'),
      price: popup.querySelector('.interactive-shopping__product-price'),
      description: popup.querySelector('.interactive-shopping__product-description'),
      options: popup.querySelector('.interactive-shopping__options'),
      button: popup.querySelector('.interactive-shopping__add-button'),
      form: popup.querySelector('.interactive-shopping__form'),
      message: popup.querySelector('.interactive-shopping__message'),
      close: popup.querySelector('.interactive-shopping__close')
    };
  }

  function isVariantAvailable(variant) {
    return Boolean(
      variant &&
      (
        variant.available === true ||
        variant.available === 'true' ||
        variant.available === 1
      )
    );
  }

  function formatPrice(cents) {
    const currency = activeRoot?.dataset.currency || 'INR';

    return new Intl.NumberFormat(
      document.documentElement.lang || 'en',
      {
        style: 'currency',
        currency: currency
      }
    ).format(Number(cents) / 100);
  }

  function updatePrice(elements) {
    if (!activeVariant) return;

    elements.price.replaceChildren();

    elements.price.appendChild(
      document.createTextNode(formatPrice(activeVariant.price))
    );

    if (
      activeVariant.compare_at_price &&
      Number(activeVariant.compare_at_price) > Number(activeVariant.price)
    ) {
      const oldPrice = document.createElement('del');
      oldPrice.textContent = formatPrice(activeVariant.compare_at_price);
      elements.price.appendChild(oldPrice);
    }
  }

  function getSwatchColor(colorName) {
    const colors = {
      black: '#000000',
      white: '#ffffff',
      red: '#ff0000',
      blue: '#0000ff',
      green: '#008000',
      yellow: '#ffff00',
      orange: '#ffa500',
      pink: '#ffc0cb',
      purple: '#800080',
      violet: '#8f00ff',
      brown: '#8b4513',
      grey: '#808080',
      gray: '#808080',
      silver: '#c0c0c0',
      gold: '#d4af37',
      beige: '#f5f5dc',
      cream: '#fffdd0',
      navy: '#000080',
      maroon: '#800000',
      olive: '#808000',
      teal: '#008080',
      coral: '#ff7f50',
      lavender: '#e6e6fa',
      charcoal: '#36454f',
      ivory: '#fffff0'
    };

    const normalized = String(colorName).trim().toLowerCase();

    if (
      /^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(normalized) ||
      /^rgba?\(/i.test(normalized) ||
      /^hsla?\(/i.test(normalized)
    ) {
      return normalized;
    }

    return colors[normalized] || '#cccccc';
  }

  /*
   * Read selected option values using original Shopify option indexes.
   */
  
    
function getSelectedOptions(elements) {
  const baseVariant = activeVariant || activeProduct.variants[0];

  return activeProduct.options.map(function (optionName, index) {
    const control = elements.options.querySelector(
      'select[data-option-index="' + index + '"]'
    );

    return control ? control.value : baseVariant.options[index];
  });
}



  /*
   * Find the matching Shopify variant and update the popup.
   */
  
function updateVariant(elements) {
  if (!activeProduct || !activeProduct.variants.length) return;

  const selectedOptions = getSelectedOptions(elements);

  console.log('Matching against variants...');

  const matchingVariant = activeProduct.variants.find(function (variant) {
    const variantOptions = variant.options || [];

    return (
      variantOptions.length === selectedOptions.length &&
      variantOptions.every(function (value, index) {
        return String(value).trim() ===
               String(selectedOptions[index]).trim();
      })
    );
  });

  console.log('Matching variant:', matchingVariant);

  elements.options.querySelectorAll(
    '.interactive-shopping__swatch'
  ).forEach(function (swatch) {
    const index = Number(swatch.dataset.optionIndex);

    const selected =
      swatch.dataset.optionValue === selectedOptions[index];

    swatch.classList.toggle('is-selected', selected);
    swatch.setAttribute('aria-pressed', String(selected));
  });

  if (!matchingVariant) {
    activeVariant = null;
    elements.price.textContent = 'This combination is unavailable.';
    elements.button.disabled = true;
    elements.button.querySelector('span:first-child').textContent =
      'UNAVAILABLE';
    return;
  }

  activeVariant = matchingVariant;

  updatePrice(elements);

  elements.image.src =
    matchingVariant.featured_image ||
    activeProduct.featured_image ||
    '';

  const available = isVariantAvailable(matchingVariant);

  elements.button.disabled = !available;

  elements.button.querySelector('span:first-child').textContent =
    available ? 'ADD TO CART' : 'SOLD OUT';
}


  /*
   * Display Color first, Size second, then all remaining options.
   * The original option indexes are preserved for variant matching.
   */
  
function renderOptions(product, elements) {
  elements.options.replaceChildren();

  const orderedOptions = product.options
    .map(function (name, index) {
      return {
        name: name,
        index: index
      };
    })
    .sort(function (a, b) {
      function priority(name) {
        const normalized = String(name).toLowerCase();

        if (normalized === 'color' || normalized === 'colour') return 0;
        if (normalized === 'size') return 1;

        return 2;
      }

      return priority(a.name) - priority(b.name) || a.index - b.index;
    });

  orderedOptions.forEach(function (optionData) {
    const optionName = optionData.name;
    const index = optionData.index;

    const values = [
      ...new Set(
        product.variants.map(function (variant) {
          return variant.options[index];
        })
      )
    ];

    // Skip Shopify's default single option.
    if (
      optionName === 'Title' &&
      values.length === 1 &&
      values[0] === 'Default Title'
    ) {
      return;
    }

    const wrapper = document.createElement('div');
    wrapper.className = 'interactive-shopping__option';

    const label = document.createElement('label');
    label.textContent = optionName;
    wrapper.appendChild(label);

    const normalizedName = String(optionName).toLowerCase();

    const isColor =
      normalizedName === 'color' ||
      normalizedName === 'colour';

    if (isColor) {
      const swatchContainer = document.createElement('div');
      swatchContainer.className = 'interactive-shopping__swatches';

      // Hidden select stores the actual Shopify option value.
      const hiddenSelect = document.createElement('select');
      hiddenSelect.dataset.optionIndex = index;
      hiddenSelect.hidden = true;
      hiddenSelect.tabIndex = -1;
      hiddenSelect.setAttribute('aria-hidden', 'true');

      
        values.forEach(function (value) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        hiddenSelect.appendChild(option);

        const swatch = document.createElement('button');
        swatch.type = 'button';
        swatch.className = 'interactive-shopping__swatch';
        swatch.dataset.optionIndex = index;
        swatch.dataset.optionValue = value;
        swatch.setAttribute('aria-label', value);
        swatch.setAttribute('aria-pressed', 'false');

        // First span: color preview
        const colorSpan = document.createElement('span');
        colorSpan.className = 'interactive-shopping__swatch-color';
        colorSpan.style.backgroundColor = getSwatchColor(value);

        // Second span: color name
        const nameSpan = document.createElement('span');
        nameSpan.className = 'interactive-shopping__swatch-name';
        nameSpan.textContent = value;

        // Add both spans inside the button
        swatch.append(colorSpan, nameSpan);

        // Handle swatch selection
        swatch.addEventListener('click', function () {
            hiddenSelect.value = this.dataset.optionValue;

            swatchContainer
            .querySelectorAll('.interactive-shopping__swatch')
            .forEach(function (button) {
                button.classList.remove('is-selected');
                button.setAttribute('aria-pressed', 'false');
            });

            this.classList.add('is-selected');
            this.setAttribute('aria-pressed', 'true');

            updateVariant(elements);
        });

        swatchContainer.appendChild(swatch);
        });


      // Set initial color from the active variant.
      hiddenSelect.value = activeVariant.options[index];

      // Mark initially selected swatch.
      swatchContainer
        .querySelectorAll('.interactive-shopping__swatch')
        .forEach(function (button) {
          const isSelected =
            button.dataset.optionValue === hiddenSelect.value;

          button.classList.toggle('is-active', isSelected);
          button.setAttribute(
            'aria-pressed',
            isSelected ? 'true' : 'false'
          );
        });

      wrapper.append(swatchContainer, hiddenSelect);

    } else {
      const select = document.createElement('select');
      select.dataset.optionIndex = index;

      values.forEach(function (value) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });

      select.value = activeVariant.options[index];

      select.addEventListener('change', function () {
        updateVariant(elements);
      });

      wrapper.appendChild(select);
    }

    elements.options.appendChild(wrapper);
  });

  // Initialize price, image, swatch selection and availability.
  updateVariant(elements);
}


  /*
   * Open popup.
   */
  function openPopup(root, product, trigger) {
    if (
      !product ||
      !Array.isArray(product.variants) ||
      !Array.isArray(product.options) ||
      product.variants.length === 0
    ) {
      console.error('Invalid Shopify product data:', product);
      return;
    }

    const firstAvailableVariant = product.variants.find(
      isVariantAvailable
    );

    // If all variants are sold out, show the first one as sold out.
    const initialVariant =
      firstAvailableVariant || product.variants[0];

    activeRoot = root;
    activeProduct = product;
    activeVariant = initialVariant;
    previousFocus = trigger;

    const elements = getElements(root);

    if (!elements) return;

    elements.image.src =
      initialVariant.featured_image ||
      product.featured_image ||
      '';

    elements.image.alt = product.title || '';
    elements.title.textContent = product.title || '';

    // Convert description HTML to plain text.
    const descriptionElement = document.createElement('div');
    descriptionElement.innerHTML = product.description || '';

    elements.description.textContent =
      descriptionElement.textContent || '';

    elements.message.textContent = '';

    // This renders the controls and calls updateVariant(elements).
    renderOptions(product, elements);

    /*
     * IMPORTANT:
     * Do not call updateVariant(root) here.
     * renderOptions already calls updateVariant(elements).
     */

    elements.popup.classList.add('is-open');
    elements.popup.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';
    elements.close.focus();

    console.log('Popup opened:', product.title);
    console.log('Available variants:', product.variants.filter(
      isVariantAvailable
    ));
    console.log('Initially selected variant:', activeVariant);
  }

  /*
   * Close popup.
   */
  function closePopup() {
    if (!activeRoot) return;

    const elements = getElements(activeRoot);

    if (elements) {
      elements.popup.classList.remove('is-open');
      elements.popup.setAttribute('aria-hidden', 'true');
    }

    document.body.style.overflow = '';

    if (previousFocus && previousFocus.isConnected) {
      previousFocus.focus();
    }

    activeRoot = null;
    activeProduct = null;
    activeVariant = null;
    previousFocus = null;
  }

  /*
   * HOTSPOT AND CLOSE EVENTS
   */
  document.addEventListener('click', function (event) {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const trigger = target.closest('[data-product-trigger]');

    if (trigger) {
      const root = trigger.closest('.interactive-shopping');

      if (!root) return;

      const productScript = document.getElementById(
        trigger.dataset.productJson
      );

      if (!productScript || !root.contains(productScript)) {
        console.error(
          'Product JSON not found:',
          trigger.dataset.productJson
        );
        return;
      }

      try {
        const product = JSON.parse(productScript.textContent.trim());

        openPopup(root, product, trigger);
      } catch (error) {
        console.error('Product JSON parsing failed:', error);
      }

      return;
    }

    if (
      activeRoot &&
      target.closest('[data-popup-close]')
    ) {
      closePopup();
    }
  });

  /*
   * ESCAPE KEY
   */
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && activeRoot) {
      closePopup();
    }
  });

  /*
   * ADD TO CART
   */
  document.addEventListener('submit', async function (event) {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const form = target.closest('.interactive-shopping__form');

    if (!form || !activeRoot) return;

    const rootAtSubmit = activeRoot;
    const elements = getElements(rootAtSubmit);

    if (!elements || form !== elements.form) return;

    event.preventDefault();

    if (!activeVariant || !isVariantAvailable(activeVariant)) {
      elements.message.textContent =
        'Please select an available variant.';
      return;
    }

    const variantId = activeVariant.id;
    const buttonLabel = elements.button.querySelector('span:first-child');

    elements.button.disabled = true;
    buttonLabel.textContent = 'ADDING...';
    elements.message.textContent = 'Adding product to cart...';

    try {
      const response = await fetch(
        (window.Shopify?.routes?.root || '/') + 'cart/add.js',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        }
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          result.description ||
          result.message ||
          'Unable to add product to cart.'
        );
      }

      // Do not update a popup that has been closed or replaced.
      if (activeRoot !== rootAtSubmit) return;

      elements.message.textContent =
        'Product successfully added to cart!';

      document.dispatchEvent(
        new CustomEvent('cart:refresh', { bubbles: true })
      );

      document.dispatchEvent(
        new CustomEvent('cart:updated', {
          bubbles: true,
          detail: { product: result }
        })
      );

      buttonLabel.textContent = 'ADDED TO CART';

    } catch (error) {
      console.error('Add to cart error:', error);

      if (activeRoot === rootAtSubmit) {
        elements.message.textContent = error.message;
        buttonLabel.textContent = 'ADD TO CART';
      }

    } finally {
      if (activeRoot === rootAtSubmit) {
        elements.button.disabled =
          !activeVariant || !isVariantAvailable(activeVariant);
      }
    }
  });

  /*
   * SHOPIFY THEME EDITOR
   */
  document.addEventListener('shopify:section:unload', function (event) {
    if (
      activeRoot &&
      activeRoot.dataset.sectionId === event.detail.sectionId
    ) {
      document.body.style.overflow = '';

      activeRoot = null;
      activeProduct = null;
      activeVariant = null;
      previousFocus = null;
    }
  });
})();
</script>

