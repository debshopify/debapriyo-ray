
{% comment %}
  Gift Guide Banner
  Shopify Online Store 2.0 Section
{% endcomment %}

<section
  id="GiftGuide-{{ section.id }}"
  class="gift-guide"
  style="
    --gg-header-bg: {{ section.settings.header_bg }};
    --gg-footer-bg: {{ section.settings.footer_bg }};
    --gg-text: {{ section.settings.text_color }};
    --gg-button-bg: {{ section.settings.button_bg }};
    --gg-button-text: {{ section.settings.button_text_color }};
    --gg-accent: {{ section.settings.accent_color }};
    --gg-content-width: {{ section.settings.content_width }}px;
    --gg-hero-bg: {{ section.settings.hero_bg }};
  "
>
  <!-- HEADER -->
  <div class="gift-guide__header">
    <div class="gift-guide__header-inner">

      <div class="gift-guide__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag:
              class: 'gift-guide__logo',
              loading: 'lazy',
              alt: section.settings.brand_name
          }}
        {% else %}
          <span class="gift-guide__brand-name">
            {{ section.settings.brand_name | escape }}
          </span>
        {% endif %}
      </div>

      <div class="gift-guide__header-message">
        {{ section.settings.header_text | escape }}
      </div>

      {% if section.settings.header_button_label != blank %}
        <a
          href="{{ section.settings.header_button_link | default: '#' }}"
          class="gift-guide__button gift-guide__button--header"
        >
          <span>{{ section.settings.header_button_label | escape }}</span>
          <span class="gift-guide__arrow" aria-hidden="true">⟶</span>
        </a>
      {% endif %}

    </div>
  </div>

  <!-- HERO BANNER -->
  <div class="gift-guide__hero">

    {% if section.settings.hero_image != blank %}
      <picture class="gift-guide__background">

        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}"
          >
        {% endif %}

        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'gift-guide__background-image',
            loading: 'lazy',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            alt: ''
        }}

      </picture>
    {% endif %}

    {% if section.settings.show_overlay %}
      <div class="gift-guide__overlay"></div>
    {% endif %}

    <div class="gift-guide__hero-inner">
      <div class="gift-guide__content">

        {% if section.settings.eyebrow != blank %}
          <p class="gift-guide__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="gift-guide__head-des-main">
            <h1 class="gift-guide__heading">
              {{ section.settings.heading | escape }}
            </h1>
        {% endif %}

        {% if section.settings.description != blank %}
            <div class="gift-guide__description">
              {{ section.settings.description }}
            </div>
          </div>
        {% endif %}

        {% if section.settings.hero_button_label != blank %}
          <a
            href="{{ section.settings.hero_button_link | default: '#' }}"
            class="gift-guide__button gift-guide__button--hero"
          >
            <span>{{ section.settings.hero_button_label | escape }}</span>
            <span class="gift-guide__arrow" aria-hidden="true">⟶</span>
          </a>
        {% endif %}

      </div>
    </div>
  </div>

  <!-- FOOTER STRIP -->
  {% if section.settings.footer_text != blank %}
    <div class="gift-guide__footer">
      <p>{{ section.settings.footer_text | escape }}</p>
    </div>
  {% endif %}

</section>

<style>
  /* =====================================
     MAIN SECTION
  ===================================== */

  #GiftGuide-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    color: var(--gg-text);
    font-family: inherit;
  }

  #GiftGuide-{{ section.id }} *,
  #GiftGuide-{{ section.id }} *::before,
  #GiftGuide-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* =====================================
     HEADER
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__header {
    width: 100%;
    background: var(--gg-header-bg);
    position: relative;
    z-index: 2;
  }

  #GiftGuide-{{ section.id }} .gift-guide__header-inner {
    width: 100%;
    max-width: 1400px;
    min-height: {{ section.settings.header_height }}px;
    margin: 0 auto;
    padding: 6px 5%;

    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    align-items: center;
    gap: 20px;
  }

  #GiftGuide-{{ section.id }} .gift-guide__brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  #GiftGuide-{{ section.id }} .gift-guide__logo {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_width }}px;
    max-height: 42px;
    object-fit: contain;
  }

  #GiftGuide-{{ section.id }} .gift-guide__brand-name {
    color: var(--gg-text);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #GiftGuide-{{ section.id }} .gift-guide__header-message {
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
  }

  /* =====================================
     HERO BANNER
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__hero {
    position: relative;
    isolation: isolate;

    display: flex;
    align-items: flex-end;

    width: 100%;
    min-height: {{ section.settings.hero_height }}px;

    background: var(--gg-hero-bg);
  }

  #GiftGuide-{{ section.id }} .gift-guide__background {
    position: absolute;
    inset: 0;
    z-index: -2;

    display: block;
    width: 100%;
    height: 100%;
  }

  #GiftGuide-{{ section.id }} .gift-guide__background-image {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #GiftGuide-{{ section.id }} .gift-guide__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;

    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    pointer-events: none;
  }

  #GiftGuide-{{ section.id }} .gift-guide__hero-inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 5%;

    display: flex;
    align-items: center;
  }

  #GiftGuide-{{ section.id }} .gift-guide__content {
    width: 100%;
    max-width: var(--gg-content-width);

    animation: giftGuideFadeIn-{{ section.id }} 0.9s ease both;
  }

  #GiftGuide-{{ section.id }} .gift-guide__eyebrow {
    margin: 0 0 12px;

    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #GiftGuide-{{ section.id }} .gift-guide__heading {
    margin: 0 0 24px;

    color: var(--gg-text);
    font-size: clamp(36px, 4.5vw, {{ section.settings.heading_size }}px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -1px;
  }

  #GiftGuide-{{ section.id }} .gift-guide__description {
    max-width: 440px;
    margin-bottom: 28px;

    font-size: 13px;
    line-height: 1.65;
  }

  #GiftGuide-{{ section.id }} .gift-guide__description p {
    margin: 0 0 10px;
  }

  /* =====================================
     COMMON BUTTON DESIGN
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__button {
    position: relative;

    display: inline-flex;
    width: 185px;
    min-width: 185px;
    height: 45px;
    min-height: 45px;

    padding: 0 42px 0 20px;

    justify-content: center;
    align-items: center;

    background: var(--gg-button-bg);
    color: var(--gg-button-text);

    border: 1px solid var(--gg-button-bg);
    border-radius: 0;

    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;

    cursor: pointer;
    overflow: hidden;

    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  /* Button text */

  #GiftGuide-{{ section.id }} .gift-guide__button > span:first-child {
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  /* Arrow positioning */

  #GiftGuide-{{ section.id }} .gift-guide__arrow {
    position: absolute;
    right: 17px;
    top: 50%;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 25px;
    font-weight: 300;
    line-height: 1;

    transform: translateY(-50%);
    transition: transform 0.35s ease;
  }

  /* Button hover */

  #GiftGuide-{{ section.id }} .gift-guide__button:hover {
    background: transparent;
    color: var(--gg-text);
    border-color: var(--gg-text);

    transform: translateY(0px);
  }

  #GiftGuide-{{ section.id }} .gift-guide__button:hover .gift-guide__arrow {
    transform: translate(6px, -50%);
  }

  /* =====================================
     HEADER BUTTON
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__button--header {
    justify-self: end;

    width: 175px;
    min-width: 175px;
    height: 40px;
    min-height: 40px;

    padding: 0 38px 0 14px;

    background: var(--gg-accent);
    color: #111111;
    border-color: var(--gg-accent);

    font-size: 12px;
  }

  #GiftGuide-{{ section.id }} .gift-guide__button--header:hover {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  #GiftGuide-{{ section.id }} .gift-guide__button--header .gift-guide__arrow {
    right: 12px;
    font-size: 22px;
  }

  /* =====================================
     HERO BUTTON
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__button--hero {
    width: 185px;
    min-width: 185px;
    height: 45px;
    min-height: 45px;
  }

  /* =====================================
     FOOTER STRIP
  ===================================== */

  #GiftGuide-{{ section.id }} .gift-guide__footer {
    width: 100%;
    min-height: {{ section.settings.footer_height }}px;

    padding: 5px 15px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: var(--gg-footer-bg);
    text-align: center;
  }

  #GiftGuide-{{ section.id }} .gift-guide__footer p {
    margin: 0;

    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  /* =====================================
     CONTENT ANIMATION
  ===================================== */

  @keyframes giftGuideFadeIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =====================================
     MOBILE RESPONSIVE
  ===================================== */

  @media screen and (max-width: 749px) {

    #GiftGuide-{{ section.id }} .gift-guide__header-inner {
      min-height: auto;
      padding: 12px 16px;

      grid-template-columns: 1fr auto;
      gap: 8px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__header-message {
      display: none;
    }

    #GiftGuide-{{ section.id }} .gift-guide__brand-name {
      font-size: 14px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__logo {
      max-width: 130px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__button--header {
      width: 155px;
      min-width: 155px;
      height: 40px;
      min-height: 40px;

      padding: 0 34px 0 10px;
      font-size: 10px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__button--header .gift-guide__arrow {
      right: 10px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__hero {
      min-height: {{ section.settings.mobile_hero_height }}px;
      align-items: flex-end;
    }

    #GiftGuide-{{ section.id }} .gift-guide__background-image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #GiftGuide-{{ section.id }} .gift-guide__hero-inner {
      padding: 45px 22px;
      text-align: center;
    }

    #GiftGuide-{{ section.id }} .gift-guide__content {
      max-width: 100%;
    }

    #GiftGuide-{{ section.id }} .gift-guide__heading {
      font-size: clamp(34px, 9vw, 48px);
      margin-bottom: 16px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__description {
      max-width: 340px;
      margin-bottom: 22px;
      font-size: 12px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__button--hero {
      width: 185px;
      min-width: 185px;
      height: 45px;
      min-height: 45px;
    }

    #GiftGuide-{{ section.id }} .gift-guide__footer p {
      font-size: 9px;
    }
  }

  /* =====================================
     REDUCED MOTION ACCESSIBILITY
  ===================================== */

  @media (prefers-reduced-motion: reduce) {
    #GiftGuide-{{ section.id }} *,
    #GiftGuide-{{ section.id }} *::before,
    #GiftGuide-{{ section.id }} *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }


/* Both buttons use the same design */

#GiftGuide-{{ section.id }} .gift-guide__button--header {
  width: 185px;
  min-width: 185px;
  height: 45px;
  min-height: 45px;

  padding: 0 42px 0 20px;

  background: #FFF544;
  color: #000;
  border: 1px solid FFF544;

  font-size: 13px;
  font-weight: 400;
  text-transform: uppercase;
}
#GiftGuide-{{ section.id }} .gift-guide__button--hero {
  width: 185px;
  min-width: 185px;
  height: 45px;
  min-height: 45px;

  padding: 0 42px 0 20px;

  background: #000;
  color: #fff;
  border: 1px solid #000;

  font-size: 13px;
  font-weight: 400;
  text-transform: uppercase;
}

/* Header button alignment */
#GiftGuide-{{ section.id }} .gift-guide__button--header {
  justify-self: end;
}

/* Same hover animation */

#GiftGuide-{{ section.id }} .gift-guide__button--header:hover {

  background: #000;
  color: #fff;
  border-color: #000;
  transform: translateY(0px);
}

#GiftGuide-{{ section.id }} .gift-guide__button--hero:hover {
  background: #FFF544;
  color: #000; 
  border-color: #FFF544;
  transform: translateY(0px);
}

/* Same arrow animation */
#GiftGuide-{{ section.id }} .gift-guide__button--header:hover .gift-guide__arrow,
#GiftGuide-{{ section.id }} .gift-guide__button--hero:hover .gift-guide__arrow {
  transform: translate(6px, -50%);
}

@media screen and (max-width: 749px) {
  #GiftGuide-{{ section.id }} .gift-guide__button--header {
    width: 180px;
    min-width: 180px;
    height: 45px;
    min-height: 45px;
    display: none;
  }

  .gift-guide__content {
        max-width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 300px;
  }
  #GiftGuide-{{ section.id }} .gift-guide__header-inner {
        display: flex;
        justify-content: center;
        align-items: center;
  }
}


</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gift-guide-banner",
  "settings": [
    {
      "type": "header",
      "content": "Header settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "TISSO VISION"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_label",
      "label": "Header button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Header button link"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 35,
      "max": 90,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "header",
      "content": "Hero image settings"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Enable image overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "hero_bg",
      "label": "Hero background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop hero height",
      "min": 350,
      "max": 850,
      "step": 25,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "mobile_hero_height",
      "label": "Mobile hero height",
      "min": 350,
      "max": 800,
      "step": 25,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Hero content settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Gift Guide"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 36,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 250,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 390
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Hero button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero button link"
    },
    {
      "type": "header",
      "content": "Footer settings"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer message",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "range",
      "id": "footer_height",
      "label": "Footer height",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Footer background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Hero button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Hero button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Header button background",
      "default": "#fff12b"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
